{
  "schema_version": 1,
  "enabled": true,
  "catalog_endpoints": {
    "internal": "https://justfun-update-catalog-staging.pw-fanat.workers.dev/v1/catalog/internal",
    "staging": "https://justfun-update-catalog-staging.pw-fanat.workers.dev/v1/catalog/staging",
    "stable": "https://justfun-update-catalog.pw-fanat.workers.dev/v1/catalog/stable"
  },
  "allowed_catalog_hosts": [
    "justfun-update-catalog-staging.pw-fanat.workers.dev",
    "justfun-update-catalog.pw-fanat.workers.dev"
  ],
  "allowed_payload_hosts": [
    "github.com",
    "release-assets.githubusercontent.com"
  ],
  "allowed_release_notes_hosts": [
    "github.com"
  ],
  "check_delay_seconds": 60,
  "check_interval_seconds": 21600,
  "max_catalog_bytes": 262144,
  "max_payload_bytes": 2000000000,
  "download_timeout_seconds": 60,
  "max_download_attempts": 3,
  "health_confirmation_timeout_seconds": 120
}
