<Window x:Class="JustFun.PremiumSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustFun Логистика"
        Width="940"
        Height="580"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Margin="14">
    <Border x:Name="ShellRoot"
            CornerRadius="17"
            Background="#071B17"
            BorderThickness="1"
            BorderBrush="#CDA44F">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25"
                          ShadowDepth="7"
                          Opacity="0.48"
                          Color="#000000" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0A211C"
                CornerRadius="16,16,0,0"
                BorderBrush="#29493F"
                BorderThickness="0,0,0,1">
          <Grid x:Name="TitleBar"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
              <Ellipse Width="25" Height="25" Margin="0,0,10,0">
                <Ellipse.Fill>
                  <ImageBrush ImageSource="pack://application:,,,/Assets/JustFun-official-transparent.png"
                              Stretch="UniformToFill"
                              Viewbox="0.045,0.025,0.906,0.946"
                              ViewboxUnits="RelativeToBoundingBox" />
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="JustFun"
                         FontWeight="SemiBold"
                         FontSize="14"
                         VerticalAlignment="Center" />
              <TextBlock Text="  /  Логистика"
                         Foreground="#829E95"
                         FontSize="13"
                         VerticalAlignment="Center" />
              <Border Background="#153A30"
                      BorderBrush="#8F7338"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="8,3"
                      Margin="12,0,0,0">
                <TextBlock x:Name="ReleaseVersionText"
                           Foreground="#E5C36F"
                           FontSize="11"
                           FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2,7,2">
              <Button Style="{StaticResource TitleBarButton}"
                      Content="—"
                      ToolTip="Свернуть"
                      Click="Minimize_Click" />
              <Button x:Name="CloseTitleButton"
                      Style="{StaticResource TitleBarButton}"
                      Content="×"
                      ToolTip="Закрыть"
                      Click="Close_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="305" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  CornerRadius="0,0,0,16"
                  BorderBrush="#8F7338"
                  BorderThickness="0,0,1,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#03130F" Offset="0" />
                <GradientStop Color="#09251E" Offset="0.52" />
                <GradientStop Color="#0D3329" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
              <Canvas Opacity="0.24" IsHitTestVisible="False">
                <Line X1="14" Y1="86" X2="74" Y2="86" Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="74" Y1="86" X2="96" Y2="108" Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="96" Y1="108" X2="132" Y2="108" Stroke="#E3B85C" StrokeThickness="1" />
                <Ellipse Canvas.Left="128" Canvas.Top="104" Width="8" Height="8"
                         Fill="#E3B85C" />
                <Line X1="238" Y1="52" X2="277" Y2="52" Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="238" Y1="52" X2="214" Y2="76" Stroke="#E3B85C" StrokeThickness="1" />
                <Ellipse Canvas.Left="208" Canvas.Top="72" Width="8" Height="8"
                         Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="0" Y1="400" X2="58" Y2="400" Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="58" Y1="400" X2="84" Y2="374" Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="84" Y1="374" X2="123" Y2="374" Stroke="#E3B85C" StrokeThickness="1" />
                <Rectangle Canvas.Left="120" Canvas.Top="370" Width="8" Height="8"
                           Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="214" Y1="437" X2="260" Y2="437" Stroke="#E3B85C" StrokeThickness="1" />
                <Line X1="260" Y1="437" X2="290" Y2="407" Stroke="#E3B85C" StrokeThickness="1" />
                <Ellipse Canvas.Left="286" Canvas.Top="402" Width="9" Height="9"
                         Fill="#E3B85C" />
              </Canvas>

              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="250">
                <Grid Width="220" Height="220" Margin="0,0,0,12">
                  <Ellipse Fill="#041612"
                           Stroke="#DAB159"
                           StrokeThickness="1.5">
                    <Ellipse.Effect>
                      <DropShadowEffect Color="#D6AB52"
                                        BlurRadius="18"
                                        ShadowDepth="0"
                                        Opacity="0.28" />
                    </Ellipse.Effect>
                  </Ellipse>
                  <Ellipse Margin="7">
                    <Ellipse.Fill>
                      <ImageBrush ImageSource="pack://application:,,,/Assets/JustFun-official-transparent.png"
                                  Stretch="UniformToFill"
                                  Viewbox="0.045,0.025,0.906,0.946"
                                  ViewboxUnits="RelativeToBoundingBox" />
                    </Ellipse.Fill>
                  </Ellipse>
                </Grid>
                <TextBlock Text="JUSTFUN"
                           Foreground="#E7C36D"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="Система автоматизации&#x0a;для малого бизнеса"
                           Foreground="#A8BBB5"
                           FontSize="13"
                           TextAlignment="Center"
                           LineHeight="20"
                           Margin="0,7,0,0" />
                <Border Background="#0B211C"
                        BorderBrush="#725B2C"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11,6"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center">
                  <TextBlock Text="WINDOWS DESKTOP"
                             Foreground="#C8A653"
                             FontSize="10"
                             FontWeight="SemiBold" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="58" />
              <RowDefinition Height="*" />
              <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#233F37"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StepOne"
                        Width="24" Height="24" CornerRadius="12"
                        Background="#E3B85C">
                  <TextBlock x:Name="StepOneText"
                             Text="1" Foreground="#071A15"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Height="1" Background="#3A5C52" Margin="7,0" />
                <Border x:Name="StepTwo"
                        Grid.Column="2"
                        Width="24" Height="24" CornerRadius="12"
                        Background="#17372F"
                        BorderBrush="#4D6D64"
                        BorderThickness="1">
                  <TextBlock x:Name="StepTwoText"
                             Text="2" Foreground="#8CA49C"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="3" Height="1" Background="#3A5C52" Margin="7,0" />
                <Border x:Name="StepThree"
                        Grid.Column="4"
                        Width="24" Height="24" CornerRadius="12"
                        Background="#17372F"
                        BorderBrush="#4D6D64"
                        BorderThickness="1">
                  <TextBlock x:Name="StepThreeText"
                             Text="3" Foreground="#8CA49C"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="5" Height="1" Background="#3A5C52" Margin="7,0" />
                <Border x:Name="StepFour"
                        Grid.Column="6"
                        Width="24" Height="24" CornerRadius="12"
                        Background="#17372F"
                        BorderBrush="#4D6D64"
                        BorderThickness="1">
                  <TextBlock x:Name="StepFourText"
                             Text="4" Foreground="#8CA49C"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,18,32,14">
              <Grid x:Name="WelcomePage">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="ПРЕМИАЛЬНАЯ УСТАНОВКА"
                             Foreground="{StaticResource GoldBrush}"
                             FontSize="11"
                             FontWeight="SemiBold" />
                  <TextBlock Text="JustFun Логистика"
                             FontSize="35"
                             FontWeight="SemiBold"
                             Margin="0,8,0,0" />
                  <TextBlock Text="Добро пожаловать в мастер установки JustFun"
                             Foreground="#C3D1CD"
                             FontSize="16"
                             Margin="0,5,0,0" />
                  <TextBlock Text="Мастер установит настольную программу, сохранит рабочие данные отдельно и проверит первый запуск до завершения."
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="13"
                             TextWrapping="Wrap"
                             LineHeight="20"
                             MaxWidth="520"
                             HorizontalAlignment="Left"
                             Margin="0,18,0,0" />
                  <Grid Margin="0,23,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#0C2A23" CornerRadius="9" Padding="13" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="01" Foreground="#DAB159" FontWeight="Bold" />
                        <TextBlock Text="Безопасное&#x0a;обновление" Margin="0,5,0,0" LineHeight="18" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#0C2A23" CornerRadius="9" Padding="13" Margin="4,0">
                      <StackPanel>
                        <TextBlock Text="02" Foreground="#DAB159" FontWeight="Bold" />
                        <TextBlock Text="Раздельные&#x0a;рабочие данные" Margin="0,5,0,0" LineHeight="18" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#0C2A23" CornerRadius="9" Padding="13" Margin="8,0,0,0">
                      <StackPanel>
                        <TextBlock Text="03" Foreground="#DAB159" FontWeight="Bold" />
                        <TextBlock Text="Проверка&#x0a;перед запуском" Margin="0,5,0,0" LineHeight="18" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Grid>

              <Grid x:Name="OptionsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Настройка установки"
                             FontSize="27"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Программа и рабочие данные всегда хранятся раздельно."
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="13"
                             Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,11,0,0">
                  <TextBlock Text="ПАПКА ПРОГРАММЫ"
                             Foreground="#91A9A1"
                             FontSize="10"
                             FontWeight="SemiBold" />
                  <Grid Height="43" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProgramDirectoryText"
                             Style="{StaticResource FieldTextBox}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                             Content="Обзор"
                             MinWidth="0"
                            Height="43"
                            Margin="8,0,0,0"
                            Click="BrowseProgram_Click" />
                  </Grid>

                  <TextBlock Text="ПАПКА РАБОЧИХ ДАННЫХ"
                             Foreground="#91A9A1"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Margin="0,9,0,0" />
                  <Grid Height="43" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DataDirectoryText"
                             Style="{StaticResource FieldTextBox}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                             Content="Обзор"
                             MinWidth="0"
                            Height="43"
                            Margin="8,0,0,0"
                            Click="BrowseData_Click" />
                  </Grid>

                  <TextBlock Text="РЕЖИМ ПЕРВОГО ЗАПУСКА"
                             Foreground="#91A9A1"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Margin="0,10,0,0" />
                  <Grid Height="54" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="FullModeRadio"
                                 GroupName="Edition"
                                 IsChecked="True"
                                 Style="{StaticResource PremiumRadio}"
                                 Margin="0,0,5,0">
                      <StackPanel>
                        <TextBlock Text="Рабочая версия" FontWeight="SemiBold" />
                        <TextBlock Text="Вход в свой аккаунт"
                                   Foreground="#8FA69E"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DemoModeRadio"
                                 Grid.Column="1"
                                 GroupName="Edition"
                                 Style="{StaticResource PremiumRadio}"
                                 Margin="5,0,0,0">
                      <StackPanel>
                        <TextBlock Text="Демонстрация" FontWeight="SemiBold" />
                        <TextBlock Text="Ознакомительный режим"
                                   Foreground="#8FA69E"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                      </StackPanel>
                    </RadioButton>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <CheckBox x:Name="DesktopShortcutCheck"
                              Style="{StaticResource PremiumCheck}"
                              IsChecked="True"
                              Content="Ярлык на рабочем столе" />
                    <CheckBox x:Name="StartShortcutCheck"
                              Style="{StaticResource PremiumCheck}"
                              IsChecked="True"
                              Content="Меню «Пуск»"
                              Margin="24,0,0,0" />
                  </StackPanel>
                  <TextBlock x:Name="ValidationMessage"
                             Foreground="#FF9D91"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,5,0,0" />
                </StackPanel>
              </Grid>

              <Grid x:Name="ProgressPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                  <Border Width="62" Height="62"
                          CornerRadius="31"
                          Background="#12372D"
                          BorderBrush="#DDB55F"
                          BorderThickness="1"
                          HorizontalAlignment="Left">
                    <TextBlock Text="JF"
                               Foreground="#E9C86F"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Устанавливаем JustFun"
                             FontSize="30"
                             FontWeight="SemiBold"
                             Margin="0,18,0,0" />
                  <TextBlock x:Name="ProgressStatusText"
                             Text="Подготовка защищённого установочного пакета"
                             Foreground="#B9CBC5"
                             FontSize="14"
                             Margin="0,8,0,0" />
                  <ProgressBar Height="8"
                               IsIndeterminate="True"
                               Foreground="#E3B85C"
                               Background="#17362E"
                               BorderThickness="0"
                               Margin="0,25,0,0" />
                  <TextBlock Text="Окно можно свернуть. Не выключайте компьютер до завершения встроенной проверки."
                             Foreground="#7F9990"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Margin="0,16,0,0" />
                </StackPanel>
              </Grid>

              <Grid x:Name="FinishPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                  <Border Width="70" Height="70"
                          CornerRadius="35"
                          Background="#173E33"
                          BorderBrush="#E3B85C"
                          BorderThickness="1.5"
                          HorizontalAlignment="Left">
                    <Path Data="M 18 36 L 30 48 L 53 23"
                          Stroke="#F2CD77"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="38" Height="32"
                          Stretch="Fill" />
                  </Border>
                  <TextBlock Text="Установка завершена"
                             FontSize="31"
                             FontWeight="SemiBold"
                             Margin="0,17,0,0" />
                  <TextBlock Text="JustFun готов к первому запуску"
                             Foreground="#B9CBC5"
                             FontSize="15"
                             Margin="0,6,0,0" />
                  <Border Background="#0C2A23"
                          CornerRadius="10"
                          BorderBrush="#31564C"
                          BorderThickness="1"
                          Padding="15,12"
                          Margin="0,20,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="Папка программы"
                                 Foreground="#809A91"
                                 FontSize="12" />
                      <TextBlock x:Name="FinishProgramPath"
                                 Grid.Column="1"
                                 TextTrimming="CharacterEllipsis"
                                 FontSize="12" />
                      <TextBlock Grid.Row="1"
                                 Text="Рабочие данные"
                                 Foreground="#809A91"
                                 FontSize="12"
                                 Margin="0,8,0,0" />
                      <TextBlock x:Name="FinishDataPath"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 TextTrimming="CharacterEllipsis"
                                 FontSize="12"
                                 Margin="0,8,0,0" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>

              <Grid x:Name="ErrorPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                  <Border Width="66" Height="66"
                          CornerRadius="33"
                          Background="#3C211E"
                          BorderBrush="#D77E6F"
                          BorderThickness="1.5"
                          HorizontalAlignment="Left">
                    <TextBlock Text="!"
                               Foreground="#FFA99B"
                               FontSize="32"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Установка не завершена"
                             FontSize="29"
                             FontWeight="SemiBold"
                             Margin="0,17,0,0" />
                  <TextBlock x:Name="ErrorMessageText"
                             Text="Обнаружена ошибка."
                             Foreground="#F0B8AF"
                             FontSize="14"
                             TextWrapping="Wrap"
                             LineHeight="21"
                             Margin="0,8,0,0" />
                  <Border Background="#241B18"
                          CornerRadius="9"
                          BorderBrush="#68423B"
                          BorderThickness="1"
                          Padding="14,11"
                          Margin="0,17,0,0">
                    <StackPanel>
                      <TextBlock Text="ЖУРНАЛ ДИАГНОСТИКИ"
                                 Foreground="#B98E86"
                                 FontSize="10"
                                 FontWeight="SemiBold" />
                      <TextBlock x:Name="ErrorLogPathText"
                                 Foreground="#E0C9C4"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="#233F37"
                    BorderThickness="0,1,0,0"
                    Padding="25,0">
              <Grid>
                <Button x:Name="BackButton"
                        Style="{StaticResource GhostButton}"
                        Content="Назад"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="Back_Click"
                        Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <Button x:Name="CancelButton"
                          Style="{StaticResource GhostButton}"
                          Content="Отмена"
                          Click="Cancel_Click" />
                  <Button x:Name="PrimaryButton"
                          Style="{StaticResource PremiumButton}"
                          Content="Продолжить"
                          Margin="10,0,0,0"
                          Click="Primary_Click" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
