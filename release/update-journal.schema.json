{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justfun.invalid/release/update-journal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "correlation_id", "installation_id_hash", "channel", "from_version", "to_version", "build_id", "commit_sha", "catalog_sequence", "state", "attempt", "created_at", "updated_at", "error", "rollback"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{16,128}$" },
    "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{16,128}$" },
    "installation_id_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "channel": { "enum": ["internal", "staging", "stable"] },
    "from_version": { "$ref": "#/$defs/semver" },
    "to_version": { "$ref": "#/$defs/semver" },
    "build_id": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "catalog_sequence": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["IDLE", "CHECKING", "UPDATE_AVAILABLE", "DOWNLOADING", "VERIFYING", "READY_TO_APPLY", "APPLYING", "AWAITING_HEALTH_CONFIRMATION", "CONFIRMED", "ROLLING_BACK", "ROLLED_BACK", "FAILED"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_-]{1,80}$" },
        "message": { "type": "string", "maxLength": 1000 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "result", "reason"],
      "properties": {
        "required": { "type": "boolean" },
        "result": { "enum": ["not-required", "pending", "succeeded", "failed"] },
        "reason": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
  }
}
