{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justfun.invalid/release/update-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "channel", "catalog_sequence", "generated_at", "expires_at", "release", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "product_id": { "const": "justfun-logistics" },
    "channel": { "enum": ["internal", "staging", "stable"] },
    "catalog_sequence": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build_id", "commit_sha", "published_at", "minimum_supported_version", "mandatory_after", "rollout_percent", "release_notes_url", "required_contracts", "payload"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "build_id": { "type": "string", "minLength": 1 },
        "commit_sha": { "$ref": "#/$defs/sha40" },
        "published_at": { "type": "string", "format": "date-time" },
        "minimum_supported_version": { "$ref": "#/$defs/semver" },
        "mandatory_after": { "type": ["string", "null"], "format": "date-time" },
        "rollout_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "release_notes_url": { "type": "string", "pattern": "^https://" },
        "required_contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reg_api", "license_auth", "telegram_broker", "storage_protocol"],
          "properties": {
            "reg_api": { "type": "integer", "minimum": 1 },
            "license_auth": { "type": "integer", "minimum": 1 },
            "telegram_broker": { "type": "integer", "minimum": 1 },
            "storage_protocol": { "type": "integer", "minimum": 1 }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_name", "url", "bytes", "sha256"],
          "properties": {
            "file_name": { "type": "string", "pattern": "^[^/\\\\]+\\.zip$" },
            "url": { "type": "string", "pattern": "^https://" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$" },
        "value": { "type": "string", "minLength": 80, "maxLength": 120 }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
