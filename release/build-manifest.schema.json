{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justfun.invalid/release/build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "product_name", "version", "channel", "commit_sha", "source_tree", "build_id", "generated_at_utc", "runner", "toolchain", "contracts", "lockfiles", "source_archive", "payload", "artifacts", "signing", "workflow", "sbom", "attestation", "test_groups"],
  "properties": {
    "schema_version": { "const": 3 },
    "product_id": { "const": "justfun-logistics" },
    "product_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["internal", "staging", "stable"] },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "build_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "os", "architecture"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "node", "npm", "electron", "nsis", "dotnet"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "npm": { "type": "string", "minLength": 1 },
        "electron": { "type": "string", "minLength": 1 },
        "nsis": { "type": "string", "minLength": 1 },
        "dotnet": { "type": "string", "minLength": 1 }
      }
    },
    "contracts": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "lockfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "source_archive": { "$ref": "#/$defs/file" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "bytes", "required_free_mb", "files"],
      "properties": {
        "runtime": { "const": "electron-protected-asar" },
        "bytes": { "type": "integer", "minimum": 1 },
        "required_free_mb": { "type": "integer", "minimum": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "recovery_helper", "update_helper", "update_payload", "update_file_manifest", "embedded_setup_engine", "pe_resource_evidence", "crash_recovery_evidence", "protected_payload_security", "official_logo_sha256", "source_encoding"],
      "properties": {
        "setup": { "$ref": "#/$defs/file" },
        "recovery_helper": { "$ref": "#/$defs/file" },
        "update_helper": { "$ref": "#/$defs/file" },
        "update_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bytes", "sha256", "unpacked_bytes", "file_count"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "unpacked_bytes": { "type": "integer", "minimum": 1 },
            "file_count": { "type": "integer", "minimum": 1 }
          }
        },
        "update_file_manifest": { "$ref": "#/$defs/file" },
        "embedded_setup_engine": { "$ref": "#/$defs/file" },
        "pe_resource_evidence": { "$ref": "#/$defs/file" },
        "crash_recovery_evidence": { "$ref": "#/$defs/file" },
        "protected_payload_security": { "$ref": "#/$defs/file" },
        "official_logo_sha256": { "$ref": "#/$defs/sha256" },
        "source_encoding": { "const": "utf-8-bom" }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "algorithm", "key_id", "authenticode_required"],
      "properties": {
        "status": { "enum": ["unsigned", "signed"] },
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": ["string", "null"] },
        "authenticode_required": { "type": "boolean" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "run_id", "url"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] } }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": { "reference": { "type": ["string", "null"] } }
    },
    "test_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
