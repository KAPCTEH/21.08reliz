{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justfun.invalid/release/test-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tests"],
  "properties": {
    "schema_version": { "const": 1 },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "level", "path", "command", "cwd", "prerequisites", "env_allowlist",
          "network_allowed", "executable_allowed", "requires_explicit_live_authorization",
          "modules", "contracts", "expected_outputs", "timeout_ms", "artifact_paths",
          "run_rule", "invalidation_rule", "class"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^JF-TEST-[A-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "level": { "enum": ["source", "integration", "windows", "live", "production"] },
          "path": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "cwd": { "type": "string", "minLength": 1 },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "env_allowlist": { "type": "array", "items": { "type": "string" } },
          "network_allowed": { "type": "boolean" },
          "executable_allowed": { "type": "boolean" },
          "requires_explicit_live_authorization": { "type": "boolean" },
          "modules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "contracts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "expected_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "timeout_ms": { "type": "integer", "minimum": 1000 },
          "artifact_paths": { "type": "array", "items": { "type": "string" } },
          "run_rule": { "type": "string", "minLength": 1 },
          "invalidation_rule": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
